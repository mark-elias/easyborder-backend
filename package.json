    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "^12.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "@types/passport-jwt": "^4.0.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.1.0",
    "passport-jwt": "^4.0.1",
